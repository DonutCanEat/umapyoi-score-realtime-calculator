{
  "name": "umapyoi-score-realtime-calculator",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "賽馬娘桌面版（繁中／簡中服）即時評價分偵測：五維分＋技能分＋ランク，HUD 疊加＋獨立面板。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-isolation=none test/*.test.js",
    "calc": "node src/cli.js",
    "pack:win": "node tools/pack-win.js"
  },
  "build": {
    "appId": "tw.umapyoi.score-realtime-calculator",
    "productName": "UmapyoiScoreRealtimeCalculator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "data/glyph-templates.json",
      "data/skill-db-tw.json",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "UmapyoiScoreRealtimeCalculator-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
